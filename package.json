{
	"name": "basic-project",
	"version": "1.0.0",
	"description": "Code repository starter template with conventional commits and automated versioning",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"predev": "npm run sanity:typegen",
		"build": "astro build",
		"prebuild": "npm run sanity:typegen",
		"preview": "astro preview",
		"astro": "astro",
		"sanity:schema:extract": "sanity schema extract --enforce-required-fields --path=./src/sanity/extract.json",
		"sanity:typegen": "node scripts/run-sanity-typegen.mjs",
		"scaffold:web-block": "node --import tsx scripts/scaffold-web-block.ts",
		"scaffold:web-portable": "node --import tsx scripts/scaffold-web-portable.ts",
		"scaffold:component": "node --import tsx scripts/scaffold-component.ts",
		"start": "npm run dev",
		"test": "node --import tsx --test tests/**/*.test.ts",
		"prepare": "husky",
		"format": "prettier --write .",
		"seed:music": "node --env-file=.env --import tsx scripts/seed-music.ts"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,vue,svelte,astro,css,scss,sass,less,html,svg,json,yaml,yml,md}": "prettier --write"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/sharp": "^0.31.1",
		"conventional-changelog-conventionalcommits": "^10.3.0",
		"husky": "^9.0.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"semantic-release": "^25.0.3",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.2",
		"@astrojs/react": "^6.0.2",
		"@sanity/assist": "^6.0.7",
		"@sanity/astro": "^3.3.1",
		"@sanity/client": "^8.0.0",
		"@sanity/visual-editing": "6.0.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-is": "^19.2.0",
		"@types/styled-components": "^5.1.36",
		"astro": "^7.2.2",
		"astro-portabletext": "^0.13.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-is": "^19.2.5",
		"sanity": "^6.9.2",
		"sanity-plugin-iframe-pane": "^5.0.13",
		"sharp": "^0.34.5",
		"styled-components": "^6.4.1"
	}
}
